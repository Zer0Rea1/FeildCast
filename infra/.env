# ============================================================
# DEPLOYMENT TARGET — the only block you change when moving
# from local/LAN testing to a real production server.
# ============================================================
# LAN/local testing (current): ENABLE_SSL=false, DOMAIN=<your LAN IP>
# Production:                  ENABLE_SSL=true,  DOMAIN=<your real domain>
#                               then get certs — see docs/DEPLOYMENT.md
ENABLE_SSL=false
DOMAIN=10.242.61.245

# Update these two together with the pair above:
#   LAN:  http / ws   (as below)
#   PROD: PUBLIC_URL=https://${DOMAIN}
#         LIVEKIT_PUBLIC_URL=wss://livekit.${DOMAIN}
PUBLIC_URL=http://10.242.61.245
LIVEKIT_PUBLIC_URL=ws://10.242.61.245:7880

# ============================================================
# Database
# ============================================================
DB_PASSWORD=dbpass786

# ============================================================
# Auth
# ============================================================
JWT_SECRET=069d26de1af236b8473b080ec2f5316bb2bf5029520e1357f4bc6d536dd88a58

# ============================================================
# SRT broadcast receiver
# ============================================================
# Running on this same machine, outside Docker → reached via host.docker.internal
# (mapped to the host machine by the extra_hosts entry on the backend service).
# If you later move the SRT receiver elsewhere on the LAN or in production,
# change this to that machine's IP/hostname.
SRT_SERVER_HOST=host.docker.internal
SRT_SERVER_PORT=3456
SRT_LATENCY_MS=200

# ============================================================
# LiveKit
# ============================================================
LIVEKIT_API_KEY=APIUeEYKxHz9JyF
LIVEKIT_API_SECRET=wkI1YtTlMA4kjALRq6rLANfdJvJfnzSfS60TUuyUG45B
