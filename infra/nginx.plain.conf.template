events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile     on;

    add_header X-Content-Type-Options  nosniff;
    add_header X-Frame-Options         SAMEORIGIN;

    upstream backend   { server backend:3000; }
    upstream webclient { server web-client:80; }

    limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;

    # Plain HTTP — no SSL certs needed. Used for LAN/local testing
    # (ENABLE_SSL=false in infra/.env). LiveKit is reached directly at
    # ws://<DOMAIN>:7880 since that port is already published by docker-compose.
    server {
        listen 80;
        server_name _;

        location /api/ {
            limit_req zone=api burst=30 nodelay;
            proxy_pass         http://backend/api/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 30s;
        }

        location /stream {
            proxy_pass         http://backend/stream;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection "upgrade";
            proxy_set_header   Host       $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering    off;
        }

        location /hls/ {
            proxy_pass http://backend/hls/;
            add_header Cache-Control       "no-cache, no-store";
            add_header Access-Control-Allow-Origin "*";
        }

        location /health {
            proxy_pass http://backend/health;
        }

        location / {
            proxy_pass       http://webclient/;
            proxy_set_header Host $host;
        }
    }
}
