# ── Database ────────────────────────────────────────────────────────────────
DB_PASSWORD=change-this-strong-password

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-64-char-random-string

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── SRT Broadcast Server ────────────────────────────────────────────────────
SRT_SERVER_HOST=your.srt-server.com
SRT_SERVER_PORT=9998
SRT_LATENCY_MS=200

# ── LiveKit ─────────────────────────────────────────────────────────────────
# Generate keys with: livekit-server generate-keys
# API Key is the short identifier, API Secret is the long secret
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-long-livekit-secret-here

# ── Web-client build args (baked into JS at build time) ─────────────────────
# LiveKit public WSS URL — clients connect directly to LiveKit for WebRTC
VITE_LIVEKIT_URL=wss://livekit.yourdomain.com
# Leave empty — nginx proxies /api and /stream to backend
VITE_API_URL=
VITE_WS_URL=
