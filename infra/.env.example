# ============================================================
# DEPLOYMENT TARGET — the only block you change when moving
# from local/LAN testing to a real production server.
# ============================================================
# LAN/local testing: ENABLE_SSL=false, DOMAIN=<your LAN IP, e.g. 192.168.1.50>
# Production:        ENABLE_SSL=true,  DOMAIN=<your real domain>
#                     then get certs — see docs/DEPLOYMENT.md
ENABLE_SSL=false
DOMAIN=192.168.1.50

# Update these two together with the pair above:
#   LAN:  PUBLIC_URL=http://<DOMAIN>            LIVEKIT_PUBLIC_URL=ws://<DOMAIN>:7880
#   PROD: PUBLIC_URL=https://<DOMAIN>           LIVEKIT_PUBLIC_URL=wss://livekit.<DOMAIN>
PUBLIC_URL=http://192.168.1.50
LIVEKIT_PUBLIC_URL=ws://192.168.1.50:7880

# ============================================================
# Database
# ============================================================
DB_PASSWORD=change-this-strong-password

# ============================================================
# Auth
# ============================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-64-char-random-string

# ============================================================
# SRT broadcast receiver
# ============================================================
# If the SRT receiver runs on this same machine outside Docker, use
# host.docker.internal (requires the extra_hosts entry already set on
# the backend service in docker-compose.yml). Otherwise use its real
# IP/hostname (LAN device or production broadcast server).
SRT_SERVER_HOST=host.docker.internal
SRT_SERVER_PORT=9998
SRT_LATENCY_MS=200

# ============================================================
# LiveKit
# ============================================================
# Generate keys with: livekit-server generate-keys
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-long-livekit-secret-here
