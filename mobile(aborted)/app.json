{
  "expo": {
    "name": "FieldCast",
    "slug": "fieldcast",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.yournewschannel.fieldcast",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.yournewschannel.fieldcast"
    }
  }
}
