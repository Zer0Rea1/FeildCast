# FieldCast Mobile App Environment Variables Example
# Copy this file to .env and adjust the values for your environment.

# API base URL for the backend server
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket URL for SRT streaming (WebSocket -> FFmpeg -> SRT bridge)
EXPO_PUBLIC_WS_URL=ws://localhost:3000/stream

# LiveKit SFU server URL for WebRTC anchor <-> reporter audio/video communication
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
