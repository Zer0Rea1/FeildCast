{
  "expo": {
    "name": "FieldCast",
    "slug": "fieldcast",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "android": {
      "package": "com.yournewschannel.fieldcast",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      [
        "@livekit/react-native",
        {
          "microphonePermission": "Allow FieldCast to access your microphone"
        }
      ]
    ]
  }
}
